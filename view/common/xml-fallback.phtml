<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\MediaRepresentation $resource
 * @var \Omeka\Api\Representation\MediaRepresentation $media
 * @var array $options
 *
 * @see \Omeka\Media\FileRenderer\FallbackRenderer::render()
 */

// Default output when the xml specific media-type is not managed.
$escape = $this->plugin('escapeHtml');
$title = $media->displayTitle();
?>
<!DOCTYPE html>
<html lang="<?= $escape($this->lang()) ?>">
<head>
    <meta charset="utf-8">
    <title><?= $escape($title) ?></title>
</head>
<body>
    <?= $this->hyperlink($media->filename(), $media->originalUrl(), ['type' => $media->mediaType(), 'target' => '_blank']) ?>
</body>
</html>
