{
    "name": "daniel-km/omeka-s-module-xml-viewer",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Allows to render xml files, like TEI.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "XML",
        "viewer",
        "TEI"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-XmlViewer",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-XmlViewer/-/work_items",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2432)": {
        "omeka/omeka-s": "^4.0",
        "daniel-km/omeka-s-module-common": "*"
    },
    "require": {
        "sempia/external-assets": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "XmlViewer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XmlViewerTest\\": "tests/XmlViewerTest/"
        }
    },
    "config": {
        "allow-plugins": {
            "sempia/external-assets": true
        }
    },
    "extra": {
        "installer-name": "XmlViewer",
        "external-assets": {
            "asset/vendor/teinte/": "https://gitlab.com/Daniel-KM/Omeka-S-module-XmlViewer/-/releases/3.4.13/downloads/teinte.tar.gz"
        }
    }
}
