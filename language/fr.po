msgstr "Le média #%s n’a pas de fichier original."

#: src/Controller/IndexController.php:54
#, php-format
msgid "Media #%s has no original file url."
msgstr "Le média #%s n’a pas d’url pour le fichier original."

#: src/Controller/IndexController.php:63
#, php-format
msgid "Media #%s has no readable file."
msgstr "Le média #%s n’a pas fichier lisible."

#: src/Controller/IndexController.php:205
msgid ""
"XmlViewer: the stylesheets {stylesheets} set in the query are skipped: only "
"the assets and the stylesheets set in settings are allowed."
msgstr ""
"XmlViewer : les feuilles de style {stylesheets} définies dans la requête "
"sont ignorées : seuls les assets et les feuilles de style définies dans les "
"réglages sont autorisés."

